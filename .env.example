# 复制本文件为 .env 后填入真实值：
#   cp .env.example .env
#
# docker compose 会自动读取同目录下的 .env。
# 也可以全部留空 —— 服务能正常启动，打开设置页填即可（会存到 ./data）。

# 大模型（兼容 OpenAI 格式：DeepSeek / 通义 / Kimi 等）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com

# 联网搜索
TAVILY_API_KEY=

# 可选。留空则使用 config.yaml 里的 model_name
LLM_MODEL=

# ---------------------------------------------------------------
# 构建镜像时用的包镜像源（仅在 docker compose build 时生效）
# 默认已指向国内镜像；海外环境改成官方源会更快：
#   PIP_INDEX_URL=https://pypi.org/simple
#   NPM_REGISTRY=https://registry.npmjs.org
# ---------------------------------------------------------------
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# NPM_REGISTRY=https://registry.npmmirror.com
